{
  "name": "civicscope",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "Free, auditable US housing and neighborhood data. Client-side, no tracking, no ads.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node tools/gen-seo.mjs",
    "build:app": "tsc -b && vite build",
    "gen:map": "node tools/gen-map-data.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "vitest run --config vitest.live.config.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "verify": "tsc -b && vitest run && vite build",
    "gate": "node --no-deprecation tools/completion-gate.mjs",
    "lint": "eslint .",
    "deploy": "npm run build && wrangler pages deploy dist --project-name civicscope",
    "deploy:preview": "npm run build && wrangler pages deploy dist --project-name civicscope --branch preview",
    "cf:login": "wrangler login",
    "cf:whoami": "wrangler whoami",
    "gen:zcta-city": "node tools/gen-zcta-city-mapping.mjs",
    "audit:variables": "node tools/audit-variables.mjs"
  },
  "dependencies": {
    "d3-geo": "^3.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^26.6.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.6.1",
    "axe-core": "^4.13.0",
    "jsdom": "^26.1.0",
    "playwright": "^1.63.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.7.2",
    "vite": "^5.4.21",
    "vitest": "^2.1.8",
    "wrangler": "^4.143.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.21.5": true
  }
}
